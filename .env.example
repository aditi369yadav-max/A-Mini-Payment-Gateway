# Application
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upi_gateway
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Retry
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Webhook
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_SIGNING_SECRET=your-webhook-secret-here

# Payment simulation
PAYMENT_PROCESSING_DELAY_MS=500
PAYMENT_SUCCESS_RATE=0.85
